# Copy to web/.env and adjust for your environment.

# Backend REST base URL. Read by every data hook in src/hooks/.
VITE_API_URL=http://localhost:8000

# Backend WebSocket URL for live telemetry, incident and reroute events.
VITE_WS_URL=ws://localhost:8000/ws

# Basemap raster tile template. The built-in default is a keyless Stadia Maps
# endpoint that only authorises requests with a localhost referer — it returns
# HTTP 401 from any other origin, leaving the map blank. Set this to a keyed
# Stadia URL or another {z}/{x}/{y} raster provider before deploying.
# VITE_MAP_TILE_URL=https://tiles.stadiamaps.com/tiles/alidade_smooth_dark/{z}/{x}/{y}.png?api_key=YOUR_KEY
