# Copy to backend/.env and adjust for your machine.

# PostGIS connection.
#
# The driver must be psycopg (v3) — the async engine in app/database.py is built
# on it. asyncpg will not work.
#
# Port 5432 is correct for the stock docker-compose setup. If you also have a
# native Postgres install (e.g. Homebrew) it will already own 127.0.0.1:5432,
# and because a specific-address bind takes precedence over Docker's wildcard
# bind, `localhost:5432` reaches the native server rather than the container.
# The symptom is a startup failure reading:
#
#     FATAL:  role "navner" does not exist
#
# Fix: add a docker-compose.override.yml publishing a spare port
#
#     services:
#       db:
#         ports:
#           - "5433:5432"
#
# and point the URL below at that port instead. Verify which server you actually
# reached with:  psql -h localhost -p <port> -U navner -d navner_ai -c 'select postgis_version()'
DATABASE_URL=postgresql+psycopg://navner:navner_secret@localhost:5432/navner_ai

# Directory for geo-tagged field photos uploaded via POST /api/v1/incident.
UPLOAD_DIR=./uploads

# Comma-separated origins allowed by the CORS middleware.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Database migrations ───────────────────────────────────────────────────────
# Schema changes are now versioned with Alembic (backend/migrations).
#   alembic upgrade head     apply pending migrations
#   alembic current          show the applied revision
#   alembic downgrade -1     roll back one revision
# Existing databases created by Base.metadata.create_all are safe to upgrade:
# each revision checks before it alters, so it is a no-op where the change is
# already present.
